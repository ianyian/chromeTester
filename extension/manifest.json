{
  "manifest_version": 3,
  "key": "",
  "name": "PCB Tester Result Collector",
  "version": "1.0.0",
  "description": "Monitors PCB tester program tabs, detects PASSED/FAILED verdicts and reports the board serial number to the MES REST API.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PCB Tester Collector"
  },
  "options_page": "options.html",
  "storage": {
    "managed_schema": "managed_schema.json"
  }
}